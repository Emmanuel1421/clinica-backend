# Porta do servidor
PORT=3000

# Caminho do banco SQLite (deixe em branco para usar o padrão: database.sqlite na raiz)
DATABASE_URL=

# Segredo JWT (use uma string longa e aleatória em produção)
JWT_SECRET=troque_este_valor_por_um_segredo_forte_em_producao

# Tempo de expiração do token em segundos (3600 = 1 hora)
SESSION_TIMEOUT=3600

# Origem permitida pelo CORS (use a URL do seu front-end em produção)
CORS_ORIGIN=*

# Ambiente
NODE_ENV=development
